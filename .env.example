# Local development only. Production secrets live in AWS Secrets Manager and
# are never committed, baked into an image or exposed to the browser.
ENVIRONMENT=local
# Optional: choose the local demo password. When unset, `make seed-demo` generates
# a random one and prints it once. Never set this outside local development.
# DEMO_PASSWORD=
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://airevenueos_app_login:local_development_only@localhost:5432/airevenueos
REDIS_URL=redis://localhost:6379/0
# Partition and retention DDL needs CREATE on the schemas. The runtime role above
# deliberately does not have it. Leave unset to disable partition maintenance; the
# job then reports that it is unavailable rather than failing silently.
MAINTENANCE_DATABASE_URL=postgresql+asyncpg://airevenueos_maintenance_login:local_development_only@localhost:5432/airevenueos

# Generate with: openssl genrsa 2048 | tee /dev/stderr | openssl rsa -pubout
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=http://localhost:8000
ENCRYPTION_MASTER_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Must list every hostname the API is *reached by*, not just the ones you type.
# TrustedHostMiddleware compares against the Host header and answers a bare
# 400 "Invalid host header" otherwise -- before authentication runs. Under
# docker compose the BFF calls the API as http://api:8000, so that file adds
# `api`; add any reverse-proxy or container name you introduce here too.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# ---------------------------------------------------------------------------
# Every externally gated capability defaults OFF. Enabling a flag without the
# corresponding credential leaves the adapter unconfigured and the feature safely
# disabled - the system never fabricates a provider result.
# ---------------------------------------------------------------------------
FEATURE_WHATSAPP_ENABLED=false      # gate: BSP/Cloud API + template approval
FEATURE_EMAIL_ENABLED=false         # gate: provider decision + sender domain
FEATURE_VOICE_ENABLED=false         # gate: legal sign-off + recording consent
FEATURE_PAYMENTS_ENABLED=false      # gate: Razorpay commercial model
FEATURE_SIGNATURES_ENABLED=false    # gate: signature provider agreement
FEATURE_CALENDAR_SYNC_ENABLED=false # gate: Google OAuth verification
FEATURE_N8N_AUTHORING_ENABLED=false # gate: hosting/licensing owner
FEATURE_AI_ENABLED=true
FEATURE_WORKFLOWS_ENABLED=true
FEATURE_WEBCHAT_ENABLED=true

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

VOICE_PROVIDER=none

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

S3_BUCKET_UPLOADS=airevenueos-local-uploads
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
CLAMAV_HOST=

SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
